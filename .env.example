# â”€â”€â”€ Local development â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# "true" runs the whole app with fake orders and a scripted agent â€” no real
# platform or Anthropic calls. The customer types an EMAIL, and its local part
# is read as a test order id: ds12345@example.com (Digistore24),
# bg12345@example.com (BuyGoods), jv12345@example.com (JVZoo). Add OPEN to
# simulate an existing case, INVALID to simulate "no purchase found" (which is
# not an error â€” support opens anyway).
MOCK_MODE=false
NEXT_PUBLIC_MOCK_MODE=false

# â”€â”€â”€ Core â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Anthropic Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Strong random password protecting /admin
ADMIN_SECRET=

# Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/support?schema=public

# â”€â”€â”€ Operating mode â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# "handoff" (default): no store is wired up, nothing is ever refunded
# automatically, and a failed retention hands the conversation to a person.
# "api": orders resolve through the platform adapters and refunds are issued.
SUPPORT_MODE=handoff

# â”€â”€â”€ Support inbox â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# The app sends no email. When a conversation is handed to a human, the
# confirmation screen gives the customer a mailto: link with the message
# already written â€” they send it themselves, to this address.
#
# So this must be a mailbox someone actually reads: a typo here means every
# handover goes nowhere and nobody finds out.
SUPPORT_EMAIL=suporte@northsupplements.online

# â”€â”€â”€ Sales platforms â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Which platforms this deployment serves, in lookup priority order.
# Leave unset to enable all three.
PLATFORMS=buygoods,digistore24,jvzoo

# Shared token appended to the BuyGoods / Digistore24 webhook URLs, e.g.
#   https://your-domain.com/api/webhooks/buygoods?token=<this value>
# Generate one with:  openssl rand -hex 32
WEBHOOK_SHARED_SECRET=

# --- Digistore24 (REST API) ---
# Account â†’ Settings â†’ API. Without this key Digistore24 lookups fall back to
# the webhook mirror only.
DIGISTORE24_API_KEY=
# Only set to true AFTER confirming your account can refund through the API.
# While unset, approved refunds go to the /admin refund queue instead.
DIGISTORE24_ENABLE_API_REFUND=false

# --- BuyGoods (webhook-first) ---
# Configure the postback URL in BuyGoods; no key needed for lookups.
# Fill these two only if you obtain REST credentials from your account manager.
BUYGOODS_API_BASE=
BUYGOODS_API_KEY=
BUYGOODS_ENABLE_API_REFUND=false

# --- JVZoo (JVZIPN webhook only) ---
# Product â†’ JVZIPN URL: https://your-domain.com/api/webhooks/jvzoo
# Then paste that product's JVZIPN secret key here.
JVZOO_SECRET_KEY=
# JVZoo documents ctransamount in cents. Set to false if your IPN log shows
# decimal amounts instead.
JVZOO_AMOUNT_IN_CENTS=true

# â”€â”€â”€ Product â†’ knowledge file mapping â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Tells the agent which knowledge/<vendor>.md to load for each product id.
# Format: platform:productId=vendorSlug, comma separated.
# Without a match, the product title is slugified instead.
PRODUCT_VENDOR_MAP=

# --- SendTrace (o banco da operacao) -----------------------------------------
# A API do painel da regua de pos-venda. Com as tres variaveis o agente:
#  - recebe os pedidos reais do cliente (status e etapa da regua) e o resumo
#    do ultimo atendimento como contexto da conversa;
#  - aprende os readmes de produto escritos no dashboard do painel (botao
#    "Produtos IA") sem precisar de deploy;
#  - grava um resumo de cada conversa de volta no banco, que vira memoria do
#    proximo atendimento.
# Sem configuracao o chat continua funcionando apenas com knowledge/ local.
#
# Autenticacao (escolha UMA):
#  - SENDTRACE_API_TOKEN: o TOKEN DE SERVICO fixo da API (API_TOKEN_SERVICO
#    no .env do servidor do SendTrace). Recomendado: sem login, sem expirar.
#  - SENDTRACE_EMAIL + SENDTRACE_SENHA: fallback, o bot loga como usuario.
SENDTRACE_API_URL=
SENDTRACE_API_TOKEN=
SENDTRACE_EMAIL=
SENDTRACE_SENHA=
