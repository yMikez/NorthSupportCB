# ===========================================================================
# Production env — place as `.env` next to docker-compose.yml on the VPS.
# DO NOT commit this file with real values.
# ===========================================================================

# ---- Postgres (dedicated to SupportChat) ----
POSTGRES_USER=supportchat
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_STRING
POSTGRES_DB=supportchat

# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Admin panel password ----
ADMIN_SECRET=CHANGE_ME_TOO

# ---- Operating mode ----
# handoff = nothing is refunded automatically; a failed retention goes to a human.
SUPPORT_MODE=handoff

# ---- Support inbox ----
# The app sends no email. When retention fails, the customer gets a mailto:
# link with the message already written and sends it from their own mail app.
# This is the address it goes to — must be a mailbox someone reads.
SUPPORT_EMAIL=suporte@northsupplements.online

# ---- Sales platforms ----
PLATFORMS=buygoods,digistore24,jvzoo

# Token appended to the BuyGoods / Digistore24 webhook URLs.
# Generate with: openssl rand -hex 32
WEBHOOK_SHARED_SECRET=CHANGE_ME_RANDOM_HEX

# Digistore24
DIGISTORE24_API_KEY=
DIGISTORE24_ENABLE_API_REFUND=false

# BuyGoods (webhook-first; REST fields optional)
BUYGOODS_API_BASE=
BUYGOODS_API_KEY=
BUYGOODS_ENABLE_API_REFUND=false

# JVZoo (JVZIPN only)
JVZOO_SECRET_KEY=
JVZOO_AMOUNT_IN_CENTS=true

# ---- Product → knowledge file mapping ----
# platform:productId=vendorSlug, comma separated
PRODUCT_VENDOR_MAP=digistore24:000000=burnthermo,jvzoo:000000=glycopulse

# ---- Mock mode (keep false in production) ----
MOCK_MODE=false
NEXT_PUBLIC_MOCK_MODE=false

# ---- SendTrace (o banco da operacao) ----
# Liga o agente ao painel da regua de pos-venda: pedidos reais do cliente,
# readmes de produto escritos no dashboard e o resumo de cada atendimento
# gravado de volta. Opcional: vazio, o agente funciona so com knowledge/.
#
# URL: o endereco da API do SendTrace alcancavel DESTA VPS (ex.:
# https://api.seudominio.com atras de proxy; ou http://127.0.0.1:4400 se
# rodar no mesmo servidor do SendTrace).
#
# Token: no VPS do SendTrace, copie o valor de
#   grep API_TOKEN_SERVICO /opt/sendtrace/painel/.env
SENDTRACE_API_URL=
SENDTRACE_API_TOKEN=
# Fallback por login (deixe vazio se usar o token acima):
SENDTRACE_EMAIL=
SENDTRACE_SENHA=
